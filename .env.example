# Environment variables read by AIGIS. All are optional.
# They are read from the process environment; no .env loader is bundled, so export them
# in your shell (or use a tool such as `dotenv run -- python run_server.py`).

# Token required in the X-AIGIS-Token header for every /api/* route.
# If unset, a random token is generated per process and injected into the dashboard.
AIGIS_API_TOKEN=

# Expose /docs, /redoc and /openapi.json (0 = off, 1 = on).
AIGIS_ENABLE_DOCS=0

# LLM provider: heuristic | gemini | groq | openrouter | openai | cerebras | sambanova | github | ollama
AIGIS_LLM_PROVIDER=heuristic

# Provider API keys (only one is used, in this order of precedence).
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
