# Environment variables read by AIGIS. All are optional.
# They are read from the process environment; no .env loader is bundled, so export them
# in your shell (or use a tool such as `dotenv run -- python run_server.py`).

# Token required in the X-AIGIS-Token header for every /api/* route.
# If unset, a random token is generated per process and injected into the dashboard.
AIGIS_API_TOKEN=

# Dashboard opens without login; the browser automatically sends the API token.

# Expose /docs, /redoc and /openapi.json (0 = off, 1 = on).
AIGIS_ENABLE_DOCS=0

# LLM provider: heuristic | gemini | groq | openrouter | openai | cerebras | sambanova | github | ollama
AIGIS_LLM_PROVIDER=heuristic

# Only the selected provider's key is read at startup; no cross-provider fallback.
# Changing provider in the UI without supplying a new key clears the old key.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
GITHUB_TOKEN=

# Optional PostgreSQL read-only source profile. Requires requirements-postgres.txt.
# Set a real DSN securely in the process environment, not in a committed file.
# AIGIS_POSTGRES_MAIN=postgresql://readonly_user:password@host:5432/database?sslmode=verify-full
# Disposable database for optional integration tests only (see docs/postgresql.md).
# AIGIS_TEST_POSTGRES_DSN=

# Durable simulation manifests; independent of the selected telemetry database.
AIGIS_RUN_DB=backend/datasets/aigis_runs.db
